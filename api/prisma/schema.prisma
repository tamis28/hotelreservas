generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Quartos {
  id              Int        @id @default(autoincrement())
  numero          String
  tipo            String
  reservas        Reservas[]
}

model Reservas {
  id              Int    @id @default(autoincrement())
  hospede         String
  data_entrada    DateTime
  data_saida      DateTime
  quartos   Quartos @relation(fields: [quartosId], references: [id])
  quartosId Int
}

